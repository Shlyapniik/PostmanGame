--- !u!114 &638023537
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 638023536}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d39004bbfc100e24f9f088e75654ad4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  relatedAddress: Oak Street 12
  beforeDeliveryDialogue:
    speakerName: Arthur Miller
    lines:
    - "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E!"
    - "\u0412\u044B \u043D\u043E\u0432\u044B\u0439 \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D?"
    - "\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0434\u043B\u044F \u043C\u0435\u043D\u044F?"
    choices:
    - text: "\u0414\u0430, \u0443 \u043C\u0435\u043D\u044F \u0434\u043B\u044F \u0432\u0430\u0441
        \u043F\u0438\u0441\u044C\u043C\u043E"
      nextLineIndex: -1
      actionId: deliver_registered_letter
      additionalActionIds: []
    - text: "\u041D\u0435\u0442, \u043F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435\u0442"
      nextLineIndex: -1
      actionId: 
      additionalActionIds: []
  afterDeliveryDialogue:
    speakerName: Arthur Miller
    lines:
    - "\u041E, \u0432\u044B \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438 \u043C\u043D\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E!"
    - "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0432\u0430\u0441.
      \u042F \u0435\u0433\u043E \u0443\u0436\u0435 \u043D\u0435\u0434\u0435\u043B\u044E
      \u0436\u0434\u0443."
    choices: []
  dialogueDatabase: {fileID: 11400000, guid: 397492b5c54d9c64da1a62682b8c3d77, type: 2}
  conditionalDialogues:
  - minimumDay: 2
    maximumDay: 2
    requiredFlags:
    - ArthurTrustsPlayer
    forbiddenFlags: []
    questConditions: []
    dialogue:
      speakerName: Arthur Miller
      lines:
      - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043D\u0435
        \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C. \u041D\u0435
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u0430\u043B \u0431\u044B
        \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0432
        \u0447\u0443\u0436\u0438\u0435 \u0434\u0435\u043B\u0430."
      - "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
        \u0437\u0430\u0432\u0442\u0440\u0430 \u044F \u043F\u043E\u043F\u0440\u043E\u0448\u0443
        \u0432\u0430\u0441 \u043A\u043E\u0435 \u043E \u0447\u0451\u043C."
      choices: []
  - minimumDay: 2
    maximumDay: 2
    requiredFlags:
    - ArthurRefusedHelp
    forbiddenFlags: []
    questConditions: []
    dialogue:
      speakerName: Arthur Miller
      lines:
      - "\u0412\u044B \u043F\u0440\u0430\u0432\u044B. \u042D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043D\u0435 \u0432\u0430\u0448\u0435 \u0434\u0435\u043B\u043E."
      - "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435
        \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E\u0431 \u044D\u0442\u043E\u043C.
        \u0425\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0434\u043D\u044F."
      choices: []
  - minimumDay: 2
    maximumDay: 2
    requiredFlags:
    - ArthurReceivedLetter
    forbiddenFlags:
    - ArthurTrustsPlayer
    - ArthurRefusedHelp
    questConditions: []
    dialogue:
      speakerName: Arthur Miller
      lines:
      - "\u042F \u0432\u0441\u0451 \u0434\u0443\u043C\u0430\u043B, \u0441\u0442\u043E\u0438\u0442
        \u043B\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
        \u0432\u0430\u043C \u043E\u0431 \u044D\u0442\u043E\u043C."
      - "\u0412\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0435 \u043F\u0438\u0441\u044C\u043C\u043E
        \u0431\u044B\u043B\u043E \u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
        \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u044F \u0441\u0447\u0438\u0442\u0430\u043B
        \u043C\u0451\u0440\u0442\u0432\u044B\u043C."
      - "\u0418 \u0441\u0430\u043C\u043E\u0435 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435
        - \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u0442 \u043C\u0435\u043D\u044F
        \u043D\u0438 \u0432 \u043A\u043E\u0435\u043C \u0441\u043B\u0443\u0447\u0430\u0435
        \u043D\u0435 \u043F\u043E\u043A\u0438\u0434\u0430\u0442\u044C \u0433\u043E\u0440\u043E\u0434."
      choices:
      - text: "\u0415\u0441\u043B\u0438 \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u0430
          \u043F\u043E\u043C\u043E\u0449\u044C, \u043C\u043E\u0436\u0435\u0442\u0435
          \u043D\u0430 \u043C\u0435\u043D\u044F \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C."
        nextLineIndex: -1
        actionId: set_flag:ArthurTrustsPlayer
        additionalActionIds: []
      - text: "\u042D\u0442\u043E \u043D\u0435 \u043C\u043E\u0451 \u0434\u0435\u043B\u043E.
          \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0437\u043D\u043E\u0448\u0443
          \u043F\u043E\u0447\u0442\u0443."
        nextLineIndex: -1
        actionId: set_flag:ArthurRefusedHelp
        additionalActionIds: []
  dayDialogues:
  - day: 2
    dialogue:
      speakerName: Arthur Miller
      lines:
      - "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u043E\u0436\u0435 \u043D\u0430
        \u043D\u043E\u0433\u0430\u0445?"
      - "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u0435\u0441\u043B\u0438
        \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B\u043E \u0433\u0440\u0443\u0431\u043E."
      - "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u043B\u0443\u0447\u0448\u0438\u0439
        \u0434\u0435\u043D\u044C."
      choices: []
  deliveryFlag: ArthurReceivedLetter
  exclusiveChoiceGroups:
  - groupName: ArthurHelpDecision
    flagIds:
    - ArthurTrustsPlayer
    - ArthurRefusedHelp
